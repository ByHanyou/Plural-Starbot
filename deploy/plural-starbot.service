[Unit]
Description=Plural Starbot (Discord bot)
After=network-online.target plural-star-cloud-node.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/node --enable-source-maps dist/index.js
Restart=always
RestartSec=5s
User=plural-starbot
WorkingDirectory=/opt/plural-starbot
EnvironmentFile=/opt/plural-starbot/.env
StateDirectory=plural-starbot
StateDirectoryMode=0700
UMask=0077

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/plural-starbot
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
