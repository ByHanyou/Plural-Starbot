# Copy this file to ".env" next to package.json and fill in every value.
# Keep .env private: the bot token is the bot's password.

# Bot token from the Discord Developer Portal (Bot -> Reset Token).
DISCORD_BOT_TOKEN=paste-your-bot-token-here

# Base URL of the Plural Star cloud node as seen from the bot.
# The bot runs on the node's machine and talks to it over localhost.
# 7523 is the node's API port (api_port in its config; /cloud is served there).
CLOUD_NODE_URL=http://127.0.0.1:7523

# Public HTTPS base under which the bot's avatar route is reachable.
# Member avatars on proxied messages are served at AVATAR_BASE_URL/avatar/<id>.
AVATAR_BASE_URL=https://node.example.org/starbot

# Local port the avatar server listens on (127.0.0.1 only).
# The reverse proxy forwards AVATAR_BASE_URL to this port.
AVATAR_PORT=8090

# Folder for the SQLite database (vault links, server settings,
# the 7-day proxied-message table). Created if it does not exist.
# With deploy/plural-starbot.service use /var/lib/plural-starbot.
DATA_DIR=./data
